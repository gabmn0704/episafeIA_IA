# EpiSafe IA - servicio de IA (copia a .env; nunca subas .env al repositorio)
NODE_ENV=development
PORT=5000

# Origenes permitidos por CORS, separados por coma ("*" solo en desarrollo)
CORS_ORIGINS=http://localhost:4000,http://localhost:5173

# Clave compartida con la API (opcional). Si se define, toda peticion excepto /health debe enviar x-api-key.
# Minimo 16 caracteres. Genera una con: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
INTERNAL_API_KEY=

# Opcional. Con clave, /explain usa Claude; sin ella usa plantillas en espanol.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000
LOG_LEVEL=info
